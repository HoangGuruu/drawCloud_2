        <UserObject label="import xml.etree.ElementTree as ET &#xa;from pathlib import Path &#xa; &#xa;INPUT = &quot;common-network-protocols.drawio&quot; &#xa;OUTPUT = &quot;common-network-protocols-aws.drawio&quot; &#xa; &#xa;# 1) Chá»n kiá»ƒu icon: &#xa;# - resourceIcon: icon vuÃ´ng 1:1 (hay dÃ¹ng trong sÆ¡ Ä‘á»“) &#xa;# - productIcon: icon dáº¡ng &quot;product&quot; cao hÆ¡n (giá»‘ng poster) &#xa;USE = &quot;resource&quot;  # &quot;resource&quot; hoáº·c &quot;product&quot; &#xa; &#xa;# 2) Mapping: protocol -&gt; aws icon key &#xa;# Báº¡n sá»­a pháº§n bÃªn pháº£i theo icon báº¡n muá»‘n. &#xa;# Icon keys vÃ­ dá»¥: cloudfront, route53, lambda, vpc, iam, cognito, vpn_gateway... &#xa;PROTO_TO_AWSICON = { &#xa;    &quot;DNS&quot;: &quot;route53&quot;, &#xa;    &quot;HTTP&quot;: &quot;cloudfront&quot;, &#xa;    &quot;TLS&quot;: &quot;certificate_manager&quot;,   # náº¿u lib báº¡n cÃ³ tÃªn khÃ¡c thÃ¬ Ä‘á»•i láº¡i &#xa;    &quot;SSH&quot;: &quot;ec2&quot;, &#xa;    &quot;SFTP&quot;: &quot;transfer_family&quot;,      # hoáº·c s3/efs tuá»³ Ã½ &#xa;    &quot;MQTT&quot;: &quot;iot_core&quot;, &#xa;    &quot;OAuth&quot;: &quot;iam&quot;,                 # hoáº·c cognito &#xa;    &quot;OpenID&quot;: &quot;cognito&quot;, &#xa;    &quot;WireGuard&quot;: &quot;vpn_gateway&quot;, &#xa;    &quot;IPsec&quot;: &quot;vpn_gateway&quot;, &#xa;    &quot;DHCP&quot;: &quot;vpc&quot;, &#xa;    &quot;NTP&quot;: &quot;cloudwatch&quot;,            # chá»‰ gá»£i Ã½ &#xa;    &quot;SMTP&quot;: &quot;ses&quot;, &#xa;    &quot;IMAP&quot;: &quot;workmail&quot;,             # chá»‰ gá»£i Ã½ &#xa;    &quot;TCP&quot;: &quot;vpc&quot;, &#xa;    &quot;UDP&quot;: &quot;vpc&quot;, &#xa;    &quot;QUIC&quot;: &quot;cloudfront&quot;, &#xa;    &quot;WebSocket&quot;: &quot;apigateway&quot;, &#xa;    &quot;WebRTC&quot;: &quot;chime&quot;,              # gá»£i Ã½ &#xa;    &quot;gRPC&quot;: &quot;apigateway&quot;, &#xa;    &quot;DoH&quot;: &quot;route53&quot;, &#xa;    &quot;LDAP&quot;: &quot;directory_service&quot;, &#xa;    &quot;SMB&quot;: &quot;fsx&quot;, &#xa;    &quot;ICMPv6&quot;: &quot;vpc&quot;, &#xa;} &#xa; &#xa;def parse_style(style: str) -&gt; dict: &#xa;    out = {} &#xa;    if not style: &#xa;        return out &#xa;    for part in style.split(&quot;;&quot;): &#xa;        if &quot;=&quot; in part: &#xa;            k, v = part.split(&quot;=&quot;, 1) &#xa;            out[k] = v &#xa;        elif part.strip(): &#xa;            out[part.strip()] = &quot;&quot; &#xa;    return out &#xa; &#xa;def build_style(old_style: str, icon_key: str) -&gt; str: &#xa;    s = parse_style(old_style) &#xa; &#xa;    # XoÃ¡ style ellipse/emoji trÆ°á»›c Ä‘Ã³ (náº¿u cÃ³) &#xa;    s.pop(&quot;shape&quot;, None) &#xa; &#xa;    # Má»™t sá»‘ defaults Ä‘áº¹p + giá»‘ng AWS icon cells &#xa;    # (CÃº phÃ¡p aws4.resourceIcon/resIcon vÃ  aws4.productIcon/prIcon lÃ  chuáº©n draw.io) &#xa;    # https://kevinhakanson.com/... vÃ  Shing Lyu blog cÃ³ snippet tÆ°Æ¡ng tá»±. &#xa;    if USE == &quot;resource&quot;: &#xa;        s[&quot;shape&quot;] = &quot;mxgraph.aws4.resourceIcon&quot; &#xa;        s[&quot;resIcon&quot;] = f&quot;mxgraph.aws4.{icon_key}&quot; &#xa;        s[&quot;aspect&quot;] = &quot;fixed&quot; &#xa;        # mÃ u/viá»n cÃ³ thá»ƒ bá» náº¿u muá»‘n AWS máº·c Ä‘á»‹nh &#xa;        s[&quot;strokeColor&quot;] = &quot;#ffffff&quot; &#xa;        s[&quot;fontColor&quot;] = &quot;#232F3E&quot; &#xa;        s[&quot;dashed&quot;] = &quot;0&quot; &#xa;        s[&quot;outlineConnect&quot;] = &quot;0&quot; &#xa;        s[&quot;html&quot;] = &quot;1&quot; &#xa;        s[&quot;align&quot;] = &quot;center&quot; &#xa;        s[&quot;verticalAlign&quot;] = &quot;top&quot; &#xa;        s[&quot;verticalLabelPosition&quot;] = &quot;bottom&quot; &#xa;        s[&quot;fontSize&quot;] = s.get(&quot;fontSize&quot;, &quot;12&quot;) &#xa;        s[&quot;fontStyle&quot;] = s.get(&quot;fontStyle&quot;, &quot;0&quot;) &#xa;    else: &#xa;        s[&quot;shape&quot;] = &quot;mxgraph.aws4.productIcon&quot; &#xa;        s[&quot;prIcon&quot;] = f&quot;mxgraph.aws4.{icon_key}&quot; &#xa;        s[&quot;aspect&quot;] = &quot;fixed&quot; &#xa;        s[&quot;strokeColor&quot;] = &quot;#ffffff&quot; &#xa;        s[&quot;html&quot;] = &quot;1&quot; &#xa;        s[&quot;align&quot;] = &quot;center&quot; &#xa;        s[&quot;verticalAlign&quot;] = &quot;bottom&quot; &#xa;        s[&quot;verticalLabelPosition&quot;] = &quot;middle&quot; &#xa;        s[&quot;fontSize&quot;] = s.get(&quot;fontSize&quot;, &quot;10&quot;) &#xa;        s[&quot;fontStyle&quot;] = s.get(&quot;fontStyle&quot;, &quot;1&quot;) &#xa; &#xa;    # rebuild &#xa;    return &quot;;&quot;.join([f&quot;{k}={v}&quot; if v != &quot;&quot; else k for k, v in s.items()]) + &quot;;&quot; &#xa; &#xa;def main(): &#xa;    tree = ET.parse(INPUT) &#xa;    root = tree.getroot() &#xa; &#xa;    # index all cells by id for quick lookup &#xa;    cells = root.findall(&quot;.//mxCell&quot;) &#xa; &#xa;    # Map icon-cell id -&gt; protocol text by scanning sibling proto cells (card_i_proto) &#xa;    # our file uses ids like card_0_icon and card_0_proto &#xa;    id_to_value = {c.get(&quot;id&quot;): c.get(&quot;value&quot;, &quot;&quot;) for c in cells} &#xa; &#xa;    changed = 0 &#xa;    for c in cells: &#xa;        cid = c.get(&quot;id&quot;, &quot;&quot;) &#xa;        if not cid.endswith(&quot;_icon&quot;): &#xa;            continue &#xa; &#xa;        base = cid[:-5]  # remove &quot;_icon&quot; &#xa;        proto_id = f&quot;{base}_proto&quot; &#xa;        proto = (id_to_value.get(proto_id) or &quot;&quot;).strip() &#xa; &#xa;        icon_key = PROTO_TO_AWSICON.get(proto) &#xa;        if not icon_key: &#xa;            # náº¿u khÃ´ng mapping, bá» qua &#xa;            continue &#xa; &#xa;        old_style = c.get(&quot;style&quot;, &quot;&quot;)_" link="import xml.etree.ElementTree as ET &#xa;from pathlib import Path &#xa; &#xa;INPUT = &quot;common-network-protocols.drawio&quot; &#xa;OUTPUT = &quot;common-network-protocols-aws.drawio&qu